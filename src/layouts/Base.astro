---
import '../styles/global.css';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SmoothScroll from '../islands/SmoothScroll.tsx';
import Reveal from '../islands/Reveal.tsx';
import WaterParallax from '../islands/WaterParallax.tsx';
import { getConfig } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';

interface Props { title?: string; description?: string; }
const { title = 'TinaCMS + Astro', description = 'Reusable blocks starter' } = Astro.props;
const config = (await getConfig()).data?.config ?? null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link rel="preconnect" href="https://images.pexels.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/>
    <link rel="preload" as="image" href="https://images.pexels.com/photos/416528/pexels-photo-416528.jpeg?auto=compress&cs=tinysrgb&w=1920" fetchpriority="high"/>
  </head>
  <body>
    <TinaIsland name="global" wrapper={islands.global.wrapper}><Header config={config} /></TinaIsland>
    <slot />
    <TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper}><Footer config={config} /></TinaIsland>
    <SmoothScroll client:idle />
    <Reveal client:visible />
    <WaterParallax client:idle />
    <script src="/js/tina-guard.js" is:inline></script>
  </body>
</html>
