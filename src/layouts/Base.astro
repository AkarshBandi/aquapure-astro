---
import '../styles/global.css';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getConfig } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';

interface Props { title?: string; description?: string; }
const { title = 'TinaCMS + Astro', description = 'Reusable blocks starter' } = Astro.props;
const config = (await getConfig()).data?.config ?? null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=DM+Sans:wght@400;500;600;700&family=Great+Vibes&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&display=swap" rel="stylesheet"/>
  </head>
  <body>
    <TinaIsland name="global" wrapper={islands.global.wrapper}><Header config={config} /></TinaIsland>
    <slot />
    <TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper}><Footer config={config} /></TinaIsland>
    <script src="/js/tina-guard.js" is:inline></script>
  </body>
</html>
