---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsConfig } from '../lib/tina/data';
interface Props { config?: CmsConfig | null; pathname?: string; }
const { config, pathname = '/' } = Astro.props as any;
const nav = (config as any)?.nav ?? [
  { title: 'Our systems', link: '#systems' },
  { title: 'Water issues', link: '#issues' },
  { title: 'Our story', link: '#story' },
  { title: 'Resources', link: '#resources' },
];
---
<header class="site-header">
  <div class="container header-wrap">
    <a href="#" class="logo" data-tina-field={tinaField(config as any, 'seo')} style="color: var(--color-dark);">AquaPure</a>
    <nav class="main-nav" aria-label="Primary" data-tina-field={tinaField(config as any, 'nav')}>
      {nav.map((item: any) => (
        <a href={item.link} class="nav-link" style={pathname===item.link ? 'color: var(--color-accent);' : ''}>{item.title}</a>
      ))}
    </nav>
    <a href="#test" class="btn btn-primary" style="padding:10px 20px; font-size:0.9rem;" data-tina-field={tinaField(config as any, 'seo')}>Free water test</a>
  </div>
</header>
