// no imports — pure static to match original live site proposition, no subscribe
---
<footer class="site-footer" style="position:relative; background: var(--color-white); border-top: 1px solid var(--color-border); overflow:hidden;">
  <!-- watery divider — subtle, not AI glow -->
  <div aria-hidden="true" style="position:absolute; top:0; left:0; right:0; height:8px; overflow:hidden;">
    <svg viewBox="0 0 1440 20" preserveAspectRatio="none" style="width:100%; height:20px; display:block; transform: translateY(-12px);">
      <path d="M0 12 Q 120 4, 240 12 T 480 12 T 720 12 T 960 12 T 1200 12 T 1440 12 L 1440 20 L 0 20 Z" fill="rgba(0,119,182,0.08)" />
      <path d="M0 14 Q 120 6, 240 14 T 480 14 T 720 14 T 960 14 T 1200 14 T 1440 14 L 1440 20 L 0 20 Z" fill="rgba(0,200,83,0.06)" />
    </svg>
  </div>
  <div class="container" style="text-align:center; padding-top: 32px; padding-bottom: 24px;">
    <nav aria-label="Footer" style="display:flex; flex-wrap:wrap; justify-content:center; gap:8px 16px; font-size:0.92rem; color: var(--color-muted);">
      <a href="#">Home</a><span style="opacity:0.3;">|</span>
      <a href="#story">About Us</a><span style="opacity:0.3;">|</span>
      <a href="#systems">Our System</a><span style="opacity:0.3;">|</span>
      <a href="#">FAQs</a><span style="opacity:0.3;">|</span>
      <a href="#">Shop</a><span style="opacity:0.3;">|</span>
      <a href="#test">Contact Us</a>
    </nav>
    <div style="margin-top:16px; font-size:0.85rem; color: var(--color-muted);">© 2026 AquaPure. All rights reserved.</div>
  </div>
</footer>
