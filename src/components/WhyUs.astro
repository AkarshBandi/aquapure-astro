---
import CountUp from '../islands/CountUp.tsx';
---
<section class="why-section" id="story">
  <div class="container why-grid">
    <div class="why-content">
      <p class="hero-eyebrow" style="color: var(--color-muted);">Why AquaPure</p>
      <h2>Water treatment designed around Arizona homes.</h2>
      <p>We’re a family business rooted in Scottsdale. For nearly two decades we’ve tested the Valley’s hardest water — well and municipal — and built systems that actually fix it.</p>
      <div class="why-stats-stack">
        <div class="why-stat-item">
          <CountUp end={20} suffix="+" client:visible />
          <h4>Years in Scottsdale</h4>
          <p>Serving Paradise Valley, Tempe, Mesa and the whole Valley since the mid-2000s.</p>
        </div>
        <div class="why-stat-item">
          <h3>Family owned</h3>
          <h4>On-site testing</h4>
          <p>One local crew, one lab-verified test at your tap, no subcontracted sales team.</p>
        </div>
        <div class="why-stat-item">
          <h3>100%</h3>
          <h4>Custom for Arizona</h4>
          <p>Every system sized to your home’s exact hardness — no generic box, every tap protected.</p>
        </div>
      </div>
    </div>
    <div class="why-visual" style="align-self: end; margin-top: 56px;">
      <div style="position:relative; border-radius:4px; overflow:hidden; border:1px solid var(--color-border);">
        <img src="https://images.pexels.com/photos/3184296/pexels-photo-3184296.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Technician testing water at kitchen sink" width="640" height="460" loading="lazy" style="width:100%; height:460px; object-fit:cover; display:block;" />
        <div style="position:absolute; inset:0; background: linear-gradient(transparent 60%, rgba(0,119,182,0.08)); pointer-events:none;"></div>
        <!-- subtle water sheen -->
        <svg viewBox="0 0 640 20" preserveAspectRatio="none" style="position:absolute; bottom:0; left:0; width:100%; height:20px; opacity:0.35;">
          <path d="M0 10 Q 80 0, 160 10 T 320 10 T 480 10 T 640 10 L 640 20 L 0 20 Z" fill="rgba(0,200,83,0.25)"/>
        </svg>
      </div>
    </div>
  </div>
</section>
<style>
  @media(max-width:1024px){ .why-visual{ align-self: auto !important; margin-top: 0 !important; } }
</style>
