---
import { tinaField } from '@tinacms/astro/tina-field';
import CtaForm from '../../islands/CtaForm.tsx';
import WaterGL from '../../islands/WaterGL.tsx';
const { data } = Astro.props as { data: any };
const bg = data?.background ?? 'https://images.pexels.com/photos/1382726/pexels-photo-1382726.jpeg?auto=compress&cs=tinysrgb&w=1920';
---
<section class="cta-section" data-tina-field={tinaField(data, 'background')}>
  <div class="cta-outer-wave cta-outer-wave--top wave-bob-ocean" aria-hidden="true">
    <svg viewBox="0 0 1440 48" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <g class="wave-layer wave-ocean-1"><path d="M0 24 C 60 4, 120 44, 180 24 S 300 4, 360 24 S 480 44, 540 24 S 660 4, 720 24 S 840 44, 900 24 S 1020 4,1080 24 S1200 44,1260 24 S1380 4,1440 24 L1440 48 L0 48 Z" fill="#0077B6"/><path d="M1440 24 C1500 4,1560 44,1620 24 S1740 4,1800 24 S1920 44,1980 24 S2100 4,2160 24 S2280 44,2340 24 S2460 4,2520 24 S2640 44,2700 24 S2820 4,2880 24 L2880 48 L1440 48 Z" fill="#0077B6"/></g>
      <g class="wave-layer wave-ocean-2"><path d="M0 28 C 40 14, 80 42, 120 28 S200 14,240 28 S320 42,360 28 S440 14,480 28 S560 42,600 28 S680 14,720 28 S800 42,840 28 S920 14,960 28 S1040 42,1080 28 S1160 14,1200 28 S1280 42,1320 28 S1400 14,1440 28 L1440 48 L0 48 Z" fill="#0284C7"/><path d="M1440 28 C1480 14,1520 42,1560 28 S1640 14,1680 28 S1760 42,1800 28 S1880 14,1920 28 S2000 42,2040 28 S2120 14,2160 28 S2240 42,2280 28 S2360 14,2400 28 S2480 42,2520 28 S2600 14,2640 28 S2720 42,2760 28 S2840 14,2880 28 L2880 48 L1440 48 Z" fill="#0284C7"/></g>
    </svg>
  </div>
  <div class="cta-water-bg" aria-hidden="true" style={`background-image: linear-gradient(rgba(0,119,182,0.72), rgba(0,119,182,0.76)), url('${bg}')`}></div>
  <WaterGL client:visible />
  <div class="container cta-wrap">
    <div class="cta-text">
      <h2 data-tina-field={tinaField(data, 'heading')}>{data?.heading ?? 'Know what’s in your water.'}</h2>
      <p data-tina-field={tinaField(data, 'text')}>{data?.text}</p>
    </div>
    <div style="min-width:320px; max-width:400px; width:100%;">
      <CtaForm id="cta-water" placeholder={data?.placeholder ?? 'Enter your email address'} buttonLabel={data?.buttonLabel ?? 'Submit'} disclaimer={data?.disclaimer} client:idle />
    </div>
  </div>
  <div class="cta-outer-wave cta-outer-wave--bottom wave-bob-ocean" aria-hidden="true">
    <svg viewBox="0 0 1440 48" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <g class="wave-layer wave-ocean-2"><path d="M0 24 C 60 4, 120 44, 180 24 S 300 4, 360 24 S 480 44, 540 24 S 660 4, 720 24 S 840 44, 900 24 S 1020 4,1080 24 S1200 44,1260 24 S1380 4,1440 24 L1440 48 L0 48 Z" fill="#0077B6"/><path d="M1440 24 C1500 4,1560 44,1620 24 S1740 4,1800 24 S1920 44,1980 24 S2100 4,2160 24 S2280 44,2340 24 S2460 4,2520 24 S2640 44,2700 24 S2820 4,2880 24 L2880 48 L1440 48 Z" fill="#0077B6"/></g>
      <g class="wave-layer wave-ocean-1"><path d="M0 28 C 40 14, 80 42, 120 28 S200 14,240 28 S320 42,360 28 S440 14,480 28 S560 42,600 28 S680 14,720 28 S800 42,840 28 S920 14,960 28 S1040 42,1080 28 S1160 14,1200 28 S1280 42,1320 28 S1400 14,1440 28 L1440 48 L0 48 Z" fill="#0284C7"/><path d="M1440 28 C1480 14,1520 42,1560 28 S1640 14,1680 28 S1760 42,1800 28 S1880 14,1920 28 S2000 42,2040 28 S2120 14,2160 28 S2240 42,2280 28 S2360 14,2400 28 S2480 42,2520 28 S2600 14,2640 28 S2720 42,2760 28 S2840 14,2880 28 L2880 48 L1440 48 Z" fill="#0284C7"/></g>
    </svg>
  </div>
</section>
