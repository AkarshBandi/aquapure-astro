---
import { tinaField } from '@tinacms/astro/tina-field';
import CtaForm from '../../islands/CtaForm.tsx';
const { data } = Astro.props as { data: any };
const bg = data?.background ?? 'https://images.pexels.com/photos/1382726/pexels-photo-1382726.jpeg?auto=compress&cs=tinysrgb&w=1920';
---
<section class="cta-section" style={`background: linear-gradient(rgba(0,119,182,0.82), rgba(0,119,182,0.84)), url('${bg}') center/cover no-repeat`} data-tina-field={tinaField(data, 'background')}>
  <div class="wave-divider wave-divider--top wave-bob" aria-hidden="true">
    <svg viewBox="0 0 1440 48" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <g class="wave-layer wave-1"><path d="M0 24 C 60 4, 120 44, 180 24 S 300 4, 360 24 S 480 44, 540 24 S 660 4, 720 24 S 840 44, 900 24 S 1020 4,1080 24 S1200 44,1260 24 S1380 4,1440 24 L1440 48 L0 48 Z" fill="#BAE6FD"/><path d="M1440 24 C1500 4,1560 44,1620 24 S1740 4,1800 24 S1920 44,1980 24 S2100 4,2160 24 S2280 44,2340 24 S2460 4,2520 24 S2640 44,2700 24 S2820 4,2880 24 L2880 48 L1440 48 Z" fill="#BAE6FD"/></g>
      <g class="wave-layer wave-2"><path d="M0 28 C 40 14, 80 42, 120 28 S200 14,240 28 S320 42,360 28 S440 14,480 28 S560 42,600 28 S680 14,720 28 S800 42,840 28 S920 14,960 28 S1040 42,1080 28 S1160 14,1200 28 S1280 42,1320 28 S1400 14,1440 28 L1440 48 L0 48 Z" fill="#BAE6FD"/><path d="M1440 28 C1480 14,1520 42,1560 28 S1640 14,1680 28 S1760 42,1800 28 S1880 14,1920 28 S2000 42,2040 28 S2120 14,2160 28 S2240 42,2280 28 S2360 14,2400 28 S2480 42,2520 28 S2600 14,2640 28 S2720 42,2760 28 S2840 14,2880 28 L2880 48 L1440 48 Z" fill="#BAE6FD"/></g>
      <g class="wave-layer wave-3"><path d="M0 32 C 30 22, 60 42, 90 32 S150 22,180 32 S240 42,270 32 S330 22,360 32 S420 42,450 32 S510 22,540 32 S600 42,630 32 S690 22,720 32 S780 42,810 32 S870 22,900 32 S960 42,990 32 S1050 22,1080 32 S1140 42,1170 32 S1230 22,1260 32 S1320 42,1350 32 S1410 22,1440 32 L1440 48 L0 48 Z" fill="#FFFFFF"/><path d="M1440 32 C1470 22,1500 42,1530 32 S1590 22,1620 32 S1680 42,1710 32 S1770 22,1800 32 S1860 42,1890 32 S1950 22,1980 32 S2040 42,2070 32 S2130 22,2160 32 S2220 42,2250 32 S2310 22,2340 32 S2400 42,2430 32 S2490 22,2520 32 S2580 42,2610 32 S2670 22,2700 32 S2760 42,2790 32 S2850 22,2880 32 L2880 48 L1440 48 Z" fill="#FFFFFF"/></g>
    </svg>
  </div>
  <div class="container cta-wrap">
    <div class="cta-text">
      <h2 data-tina-field={tinaField(data, 'heading')}>{data?.heading ?? 'Know what’s in your water.'}</h2>
      <p data-tina-field={tinaField(data, 'text')}>{data?.text}</p>
    </div>
    <div style="min-width:320px; max-width:400px; width:100%;">
      <CtaForm id="cta-water" placeholder={data?.placeholder ?? 'Enter your email address'} buttonLabel={data?.buttonLabel ?? 'Submit'} disclaimer={data?.disclaimer} client:idle />
    </div>
  </div>
</section>
