---
import { tinaField } from '@tinacms/astro/tina-field';
import CtaForm from '../../islands/CtaForm.tsx';
import Water3D from '../../islands/Water3D.tsx';
const { data } = Astro.props as { data: any };
const bg = data?.background ?? 'https://images.pexels.com/photos/1382726/pexels-photo-1382726.jpeg?auto=compress&cs=tinysrgb&w=1920';
---
<section class="cta-section" data-tina-field={tinaField(data, 'background')}>
  <svg width="0" height="0" aria-hidden="true" style="position:absolute"><defs><clipPath id="ctaWavyClip" clipPathUnits="objectBoundingBox"><path d="M0,0.14 C0.04,0.02 0.083,0.26 0.125,0.14 S0.208,0.02 0.25,0.14 S0.333,0.26 0.375,0.14 S0.458,0.02 0.5,0.14 S0.583,0.26 0.625,0.14 S0.708,0.02 0.75,0.14 S0.833,0.26 0.875,0.14 S0.958,0.02 1,0.14 L1,0.86 C0.958,0.98 0.917,0.74 0.875,0.86 S0.792,0.98 0.75,0.86 S0.667,0.74 0.625,0.86 S0.542,0.98 0.5,0.86 S0.417,0.74 0.375,0.86 S0.292,0.98 0.25,0.86 S0.167,0.74 0.125,0.86 S0.042,0.98 0,0.86 Z" /></clipPath></defs></svg>
  <div class="cta-water-wavy">
    <div class="cta-water-bg" aria-hidden="true" style={`background-image: linear-gradient(rgba(0,119,182,0.70), rgba(0,119,182,0.74)), url('${bg}')`}></div>
    <Water3D client:visible />
    <div class="container cta-wrap">
      <div class="cta-text">
        <h2 data-tina-field={tinaField(data, 'heading')}>{data?.heading ?? 'Know what’s in your water.'}</h2>
        <p data-tina-field={tinaField(data, 'text')}>{data?.text}</p>
      </div>
      <div style="min-width:320px; max-width:400px; width:100%;">
        <CtaForm id="cta-water" placeholder={data?.placeholder ?? 'Enter your email address'} buttonLabel={data?.buttonLabel ?? 'Submit'} disclaimer={data?.disclaimer} client:idle />
      </div>
    </div>
  </div>
</section>
