---
import { tinaField } from '@tinacms/astro/tina-field';
import Hero from './Hero.astro';
import RichText from './RichText.astro';
import Media from './Media.astro';
import Cta from './Cta.astro';
import Gallery from './Gallery.astro';
import Accordion from './Accordion.astro';
import Stats from './Stats.astro';
import Testimonial from './Testimonial.astro';
import AquaHero from './AquaHero.astro';
import KnowWater from './KnowWater.astro';
import SystemWater from './SystemWater.astro';
import WhyWater from './WhyWater.astro';
import CtaWater from './CtaWater.astro';

const { data } = Astro.props as { data: any };
const blocks = (data?.blocks ?? []).filter(Boolean);
---
{blocks.map((block: any) => {
  const rendered = (() => {
    switch (block?.__typename) {
      case 'PageBlocksHero':
        return <Hero data={block} />;
      case 'PageBlocksRichText':
        return <RichText data={block} />;
      case 'PageBlocksMedia':
        return <Media data={block} />;
      case 'PageBlocksCta':
        return <Cta data={block} />;
      case 'PageBlocksGallery':
        return <Gallery data={block} />;
      case 'PageBlocksAccordion':
        return <Accordion data={block} />;
      case 'PageBlocksStats':
        return <Stats data={block} />;
      case 'PageBlocksTestimonial':
        return <Testimonial data={block} />;
      case 'PageBlocksAquaHero':
        return <AquaHero data={block} />;
      case 'PageBlocksKnowWater':
        return <KnowWater data={block} />;
      case 'PageBlocksSystemWater':
        return <SystemWater data={block} />;
      case 'PageBlocksWhyWater':
        return <WhyWater data={block} />;
      case 'PageBlocksCtaWater':
        return <CtaWater data={block} />;
      default:
        return null;
    }
  })();
  return <div data-tina-field={tinaField(block)}>{rendered}</div>;
})}
