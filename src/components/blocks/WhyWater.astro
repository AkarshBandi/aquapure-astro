---
import { tinaField } from '@tinacms/astro/tina-field';
import CountUp from '../../islands/CountUp.tsx';
const { data } = Astro.props as { data: any };
const stats = (data?.stats ?? []).filter(Boolean);
---
<section class="why-section" id="story" data-tina-field={tinaField(data)}>
  <div class="container why-grid">
    <div class="why-content">
      <p class="hero-eyebrow" style="color: var(--color-muted);" data-tina-field={tinaField(data, 'eyebrow')}>{data?.eyebrow ?? 'Why AquaPure'}</p>
      <h2 data-tina-field={tinaField(data, 'heading')}>{data?.heading ?? 'Water treatment designed around Arizona homes.'}</h2>
      <p data-tina-field={tinaField(data, 'paragraph')}>{data?.paragraph}</p>
      <div class="why-stats-stack" data-tina-field={tinaField(data, 'stats')}>
        {stats.map((s: any) => (
          <div class="why-stat-item">
            <h3 data-tina-field={tinaField(s, 'value')}>{s.value}</h3>
            <h4 data-tina-field={tinaField(s, 'label')}>{s.label}</h4>
            <p data-tina-field={tinaField(s, 'text')}>{s.text}</p>
          </div>
        ))}
        {/* Keep CountUp for first stat if it looks like a number */}
        {stats[0]?.value?.match(/^\d+/) && <div style="display:none"><CountUp end={parseInt(stats[0].value)} suffix="+" client:visible /></div>}
      </div>
    </div>
    <div class="why-visual" style="align-self: end; margin-top: 56px;">
      <div style="position:relative; border-radius:4px; overflow:hidden; border:1px solid var(--color-border);">
        {data?.featureImage ? <img src={data.featureImage} alt={data?.heading ?? ''} width="640" height="460" loading="lazy" style="width:100%; height:460px; object-fit:cover; display:block;" data-tina-field={tinaField(data, 'featureImage')} /> : <div class="placeholder-image" style="height:460px"></div>}
        <svg viewBox="0 0 640 20" preserveAspectRatio="none" style="position:absolute; bottom:0; left:0; width:100%; height:20px; opacity:0.35;">
          <path d="M0 10 Q 80 0, 160 10 T 320 10 T 480 10 T 640 10 L 640 20 L 0 20 Z" fill="rgba(0,200,83,0.25)"/>
        </svg>
      </div>
    </div>
  </div>
</section>
<style>
  @media(max-width:1024px){ .why-visual{ align-self: auto !important; margin-top: 0 !important; } }
</style>
