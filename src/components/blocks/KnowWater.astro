---
import { tinaField } from '@tinacms/astro/tina-field';
const { data } = Astro.props as { data: any };
const subs = (data?.subFeatures ?? []).filter(Boolean);
---
<section class="know-section" id="issues" data-tina-field={tinaField(data)}>
  <div class="container know-grid">
    <div class="know-content">
      <p class="hero-eyebrow" style="color: var(--color-muted);" data-tina-field={tinaField(data, 'eyebrow')}>{data?.eyebrow ?? 'Why it matters'}</p>
      <h2 data-tina-field={tinaField(data, 'heading')}>{data?.heading ?? 'Know your water'}</h2>
      <p data-tina-field={tinaField(data, 'paragraph')}>{data?.paragraph}</p>
      <div class="know-sub-features" data-tina-field={tinaField(data, 'subFeatures')}>
        {subs.map((s: any) => (
          <div class="sub-feature">
            <h3 data-tina-field={tinaField(s, 'title')}>{s.title}</h3>
            <p data-tina-field={tinaField(s, 'text')}>{s.text}</p>
          </div>
        ))}
      </div>
      <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
        <a href={data?.learnLink ?? '#systems'} class="btn btn-secondary" data-tina-field={tinaField(data, 'learnLabel')}>{data?.learnLabel ?? 'Learn how it works'}</a>
        <a href={data?.moreLink ?? '#systems'} class="btn btn-secondary" style="background: var(--color-accent); color:#fff; border-color: var(--color-accent);" data-tina-field={tinaField(data, 'moreLabel')}>{data?.moreLabel ?? 'More'}</a>
      </div>
    </div>
    <div class="know-visual">
      {data?.featureImage ? <img src={data.featureImage} alt={data?.heading ?? ''} width="640" height="440" loading="lazy" style="width:100%; height:440px; object-fit:cover; border-radius:4px; border:1px solid var(--color-border);" data-tina-field={tinaField(data, 'featureImage')} /> : <div class="placeholder-image" style="height:440px"></div>}
    </div>
  </div>
</section>
